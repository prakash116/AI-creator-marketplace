# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins (CORS). Required in production.
FRONTEND_URL=http://localhost:3000

# --- Database ---
# Leave empty for in-memory mode (dev only). Required in production.
# URL-encode special characters in the password (@ -> %40).
MONGODB_URI=
# Optional: DNS servers used if the system resolver can't resolve mongodb+srv records.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# --- Auth ---
# Production requires >= 32 random chars: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# --- Media (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
